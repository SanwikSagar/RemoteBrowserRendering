{
  "name": "remote-browser-rendering",
  "version": "2.1.0",
  "description": "Remote browser rendering over WebSocket: adaptive-quality JPEG video via CDP screencast plus real Opus/WebM audio capture",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=128 src/server.js",
    "start:gc": "node --expose-gc src/server.js",
    "dev": "node --watch src/server.js",
    "dev:gc": "node --watch --expose-gc src/server.js",
    "deploy": "git push origin main"
  },
  "keywords": [
    "browser",
    "rendering",
    "puppeteer",
    "streaming",
    "jpeg",
    "webrtc-alternative",
    "audio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "puppeteer": "^24.15.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

